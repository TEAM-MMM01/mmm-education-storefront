{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preparationstation.example/schemas/order-record.schema.json",
  "title": "Preparation Station customer order record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "customer_id",
    "source",
    "source_reference",
    "status",
    "placed_at",
    "updated_at",
    "items"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^PSO-[A-Z0-9-]{8,40}$"
    },
    "customer_id": {
      "type": "string",
      "minLength": 1,
      "description": "Private backend identifier; never expose another customer's record."
    },
    "source": {
      "enum": [
        "tefa_odyssey",
        "direct_site"
      ]
    },
    "source_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "received",
        "action_required",
        "approved",
        "processing",
        "shipped",
        "completed",
        "canceled",
        "refunded"
      ]
    },
    "placed_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "name",
          "quantity"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^(PS|GEN)-[A-Z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    },
    "carrier": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "tracking_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    }
  }
}
