# Server-only Worker secrets. Never commit values.
# Set them with Wrangler after owner approval:
#   wrangler secret put TURNSTILE_SECRET_KEY
#   wrangler secret put RESEND_API_KEY
#
# Public/non-secret Worker vars live in wrangler.toml:
#   ALLOWED_ORIGIN
#   TURNSTILE_HOSTNAMES
#   OPERATIONS_EMAIL
#   RESEND_FROM_EMAIL
#
# The public Turnstile sitekey belongs in config/request-intake.json
# as turnstile_sitekey. Do not put the secret there.

TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
